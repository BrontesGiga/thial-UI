---
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "@fontsource/prata/latin-400.css";
import "@fontsource/lora/latin-400.css";
import "@fontsource/lora/latin-400-italic.css";
import "@fontsource/lora/latin-600.css";
import "../styles/tokens.css";
import "../styles/global.css";
import { locales, localizedPath, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const canonical = new URL(localizedPath(locale), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localizedPath(l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath("es"), Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>
