---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CandleItem {
  id: string;
  name: string;
  collectionName: string;
  aroma: string;
  phrase: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  candle: CandleItem;
  aromaLabel: string;
  addLabel: string;
  addedLabel: string;
}
const { candle, aromaLabel, addLabel, addedLabel } = Astro.props;
---

<article class="card">
  <Image
    src={candle.image}
    alt={candle.imageAlt}
    widths={[320, 640]}
    sizes="(max-width: 40rem) 100vw, 25vw"
  />
  <div class="body">
    <p class="collection">{candle.collectionName}</p>
    <h3>{candle.name}</h3>
    <p class="aroma">
      <span>{aromaLabel}:</span> {candle.aroma}
    </p>
    <p class="phrase">“{candle.phrase}”</p>
    <button
      type="button"
      class="add"
      data-add-to-cart
      data-id={candle.id}
      data-name={candle.name}
      data-added-label={addedLabel}
    >
      {addLabel}
    </button>
  </div>
</article>

<script>
  import { addItem, readCart, writeCart } from "../lib/cart";

  // Delegated: Astro dedupes this script across every CandleCard instance.
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-add-to-cart]",
    );
    if (!button) return;

    const { id, name, addedLabel } = button.dataset;
    if (!id || !name) return;

    writeCart(addItem(readCart(), { id, name }));

    const originalLabel =
      button.dataset.originalLabel ?? button.textContent ?? "";
    button.dataset.originalLabel = originalLabel;
    button.textContent = addedLabel ?? originalLabel;

    const status = button
      .closest("ul")
      ?.parentElement?.querySelector<HTMLElement>("[data-cart-status]");
    if (status) status.textContent = addedLabel ?? "";

    window.setTimeout(() => {
      button.textContent = button.dataset.originalLabel ?? originalLabel;
    }, 1500);
  });
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-ivory);
    border: var(--rule);
    border-radius: 0.5rem;
  }
  .card {
    transition: box-shadow 0.25s ease;
  }
  .card:hover,
  .card:focus-within {
    box-shadow: 0 0.75rem 1.5rem -0.5rem rgb(0 0 0 / 25%);
  }
  img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
    transform: scale(1.08);
    transition: transform 0.25s ease;
  }
  .card:hover img,
  .card:focus-within img {
    transform: scale(1.14);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    img {
      transition: none;
    }
    .card:hover img,
    .card:focus-within img {
      transform: none;
    }
  }
  .body {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m);
    text-align: center;
  }
  .collection {
    color: var(--color-sage);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h3 {
    font-size: var(--text-lg);
    transition: color 0.25s ease;
  }
  .card:hover h3,
  .card:focus-within h3 {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    h3 {
      transition: none;
    }
  }
  .aroma {
    font-size: var(--text-sm);
  }
  .aroma span {
    font-weight: 600;
  }
  .phrase {
    margin-top: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-gold);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.35;
  }
  .add {
    justify-self: center;
    min-height: 2.75rem;
    margin-top: var(--space-xs);
    padding: 0 var(--space-m);
    border: 0;
    border-radius: var(--radius);
    background: var(--color-raspberry);
    color: var(--color-ivory);
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }
  .add:hover {
    background: var(--color-taupe);
    transform: translateY(-0.15rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .add {
      transition: none;
    }
    .add:hover {
      transform: none;
    }
  }
</style>
