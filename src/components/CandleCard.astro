---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CandleItem {
  id: string;
  name: string;
  collectionName: string;
  aroma: string;
  phrase: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  candle: CandleItem;
  aromaLabel: string;
}
const { candle, aromaLabel } = Astro.props;
---

<article class="card">
  <Image
    src={candle.image}
    alt={candle.imageAlt}
    widths={[320, 640]}
    sizes="(max-width: 40rem) 100vw, 25vw"
  />
  <div class="body">
    <p class="collection">{candle.collectionName}</p>
    <h3>{candle.name}</h3>
    <p class="aroma">
      <span>{aromaLabel}:</span> {candle.aroma}
    </p>
    <p class="phrase">“{candle.phrase}”</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-ivory);
    border: var(--rule);
  }
  img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .body {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m);
    text-align: center;
  }
  .collection {
    color: var(--color-sage);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h3 {
    font-size: var(--text-lg);
  }
  .aroma {
    font-size: var(--text-sm);
  }
  .aroma span {
    font-weight: 600;
  }
  .phrase {
    margin-top: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-gold);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.35;
  }
</style>
