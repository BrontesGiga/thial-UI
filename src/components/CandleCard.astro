---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CandleItem {
  id: string;
  name: string;
  collectionName: string;
  aroma: string;
  phrase: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  candle: CandleItem;
  aromaLabel: string;
}
const { candle, aromaLabel } = Astro.props;
---

<article class="card">
  <Image
    src={candle.image}
    alt={candle.imageAlt}
    widths={[320, 640]}
    sizes="(max-width: 40rem) 100vw, 25vw"
  />
  <div class="body">
    <p class="collection">{candle.collectionName}</p>
    <h3>{candle.name}</h3>
    <p class="aroma">
      <span>{aromaLabel}:</span> {candle.aroma}
    </p>
    <p class="phrase">“{candle.phrase}”</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-ivory);
    border: var(--rule);
    border-radius: 0.5rem;
  }
  .card {
    transition: box-shadow 0.25s ease;
  }
  .card:hover,
  .card:focus-within {
    box-shadow: 0 0.75rem 1.5rem -0.5rem rgb(0 0 0 / 25%);
  }
  img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
    transform: scale(1.08);
    transition: transform 0.25s ease;
  }
  .card:hover img,
  .card:focus-within img {
    transform: scale(1.14);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    img {
      transition: none;
    }
    .card:hover img,
    .card:focus-within img {
      transform: none;
    }
  }
  .body {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m);
    text-align: center;
  }
  .collection {
    color: var(--color-sage);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h3 {
    font-size: var(--text-lg);
    transition: color 0.25s ease;
  }
  .card:hover h3,
  .card:focus-within h3 {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    h3 {
      transition: none;
    }
  }
  .aroma {
    font-size: var(--text-sm);
  }
  .aroma span {
    font-weight: 600;
  }
  .phrase {
    margin-top: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-gold);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.35;
  }
</style>
