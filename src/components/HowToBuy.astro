---
import Divider from "./Divider.astro";
import { links } from "../config/links";
import type { Dictionary } from "../i18n/utils";

interface Props {
  buy: Dictionary["buy"];
}
const { buy } = Astro.props;
---

<section id="buy" class="section buy" aria-labelledby="buy-title">
  <div>
    <h2 id="buy-title" class="section-title">
      {buy.title}
    </h2>
    <p class="intro">{buy.intro}</p>
    <ol>
      {buy.steps.map((step, i) => (
        <li>
          <span class="number" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <Divider vertical />
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="actions">
      <a class="button" href={links.instagram}>
        <svg
          class="icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="currentColor"
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069M12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98C23.986 15.668 24 15.259 24 12s-.014-3.668-.072-4.948C23.73 2.7 21.308.273 16.949.073 15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"
          ></path>
        </svg>
        {buy.instagram}
      </a>
      <a class="button" href={links.whatsapp}>
        <svg
          class="icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="currentColor"
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .102 5.36.1 11.943c0 2.107.549 4.163 1.595 5.985L0 24l6.335-1.652a11.882 11.882 0 0 0 5.71 1.447h.006c6.585 0 11.946-5.36 11.949-11.943a11.87 11.87 0 0 0-3.48-8.403"
          ></path>
        </svg>
        {buy.whatsapp}
      </a>
    </div>
  </div>
</section>

<style>
  .buy {
    background: var(--color-surface);
  }
  .intro {
    text-align: center;
  }
  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding: 0;
    list-style: none;
    text-align: center;
  }
  ol > li {
    transition: transform 0.25s ease;
  }
  ol > li:hover,
  ol > li:focus-within {
    transform: translateY(-0.25rem);
  }
  .number {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    transition: color 0.25s ease;
  }
  h3 {
    margin-top: var(--space-s);
    transition: color 0.25s ease;
  }
  ol > li:hover .number,
  ol > li:focus-within .number,
  ol > li:hover h3,
  ol > li:focus-within h3 {
    color: var(--color-accent);
  }
  li p {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    ol > li,
    .number,
    h3 {
      transition: none;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius);
    background: var(--color-raspberry);
    color: var(--color-ivory);
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }
  .icon {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .button:hover {
    background: var(--color-taupe);
    transform: translateY(-0.15rem);
  }
  .button:hover .icon {
    transform: scale(1.15);
  }
  @media (prefers-reduced-motion: reduce) {
    .button,
    .icon {
      transition: none;
    }
    .button:hover {
      transform: none;
    }
    .button:hover .icon {
      transform: none;
    }
  }
</style>
