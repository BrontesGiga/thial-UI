---
import Divider from "./Divider.astro";
import { links } from "../config/links";
import type { Dictionary } from "../i18n/utils";

interface Props {
  buy: Dictionary["buy"];
}
const { buy } = Astro.props;
---

<section id="buy" class="section buy" aria-labelledby="buy-title">
  <div>
    <h2 id="buy-title" class="section-title">
      {buy.title}
    </h2>
    <p class="intro">{buy.intro}</p>
    <ol>
      {buy.steps.map((step, i) => (
        <li>
          <span class="number" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <Divider vertical />
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="actions">
      <a class="button" href={links.instagram}>
        {buy.instagram}
      </a>
      <a class="button" href={links.whatsapp}>
        {buy.whatsapp}
      </a>
    </div>
  </div>
</section>

<style>
  .buy {
    background: var(--color-surface);
  }
  .intro {
    text-align: center;
  }
  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding: 0;
    list-style: none;
    text-align: center;
  }
  .number {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
  }
  h3 {
    margin-top: var(--space-s);
  }
  li p {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }
  .button {
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius);
    background: var(--color-raspberry);
    color: var(--color-ivory);
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .button:hover {
    background: var(--color-taupe);
  }
</style>
