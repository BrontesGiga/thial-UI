---
import Logo from "../assets/logo/thial-logo.svg";
import type { Dictionary } from "../i18n/utils";

interface Props {
  nav: Dictionary["nav"];
  homeHref: string;
  switchHref: string;
  switchLang: string;
  sectionBase?: string;
  cartHref: string;
}
const {
  nav,
  homeHref,
  switchHref,
  switchLang,
  sectionBase = "",
  cartHref,
} = Astro.props;

const items = [
  { id: "essence", label: nav.essence },
  { id: "values", label: nav.values },
  { id: "collections", label: nav.collections },
  { id: "candles", label: nav.candles },
  { id: "faq", label: nav.faq },
  { id: "buy", label: nav.buy },
];
---

<a class="skip-link" href="#main">
  {nav.skip}
</a>
<header class="header">
  <div class="inner">
    <a class="home" href={homeHref} aria-label={nav.homeLabel}>
      <Logo class="logo" aria-hidden="true" />
    </a>
    <div class="menu">
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
      >
        <svg
          viewBox="0 0 20 14"
          width="20"
          height="14"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M0 1h20M0 7h20M0 13h20"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
        </svg>
        {nav.menu}
      </button>
      <nav id="site-nav" aria-label={nav.label}>
        <ul>
          {items.map((item) => (
            <li>
              <a href={`${sectionBase}#${item.id}`}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <a
      class="cart"
      href={cartHref}
      data-cart-link
      data-label-template={nav.cartLabel}
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M7 4h-2l-.94 2H2v2h1.06l2.76 8.28A2 2 0 0 0 7.72 18H17v-2H7.72l-.33-1H17.4a2 2 0 0 0 1.9-1.37L21 8H6.16l-.5-1.5A1 1 0 0 0 4.72 6H2V4h5Zm11.6 6-1.34 4H8.53L7.2 10ZM9 20a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
        ></path>
      </svg>
      <span class="cart-text">{nav.cart}</span>
      <span class="badge" data-cart-count hidden>
        0
      </span>
    </a>
    <a
      class="lang"
      href={switchHref}
      hreflang={switchLang}
      lang={switchLang}
      aria-label={nav.switchLabel}
      data-lang-switch
    >
      {nav.switchTo}
    </a>
  </div>
</header>

<script>
  // Keep the current section when switching language.
  document
    .querySelector<HTMLAnchorElement>("[data-lang-switch]")
    ?.addEventListener("click", (event) => {
      const link = event.currentTarget as HTMLAnchorElement;
      if (location.hash) link.hash = location.hash;
    });

  // Mobile menu. Without JS the nav stays visible as a wrapped row.
  const header = document.querySelector<HTMLElement>(".header");
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = document.getElementById("site-nav");

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      header.dataset.menu = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
    };
    const isOpen = () => header.dataset.menu === "open";

    setOpen(false);
    toggle.addEventListener("click", () => setOpen(!isOpen()));
    nav.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });
  }
</script>

<script>
  import { CART_EVENT, CART_KEY, cartCount, readCart } from "../lib/cart";

  const link = document.querySelector<HTMLAnchorElement>("[data-cart-link]");
  const badge = link?.querySelector<HTMLElement>("[data-cart-count]");
  const template = link?.dataset.labelTemplate ?? "";

  function updateBadge() {
    if (!link || !badge) return;
    const count = cartCount(readCart());
    badge.textContent = String(count);
    badge.hidden = count === 0;
    link.setAttribute("aria-label", template.replace("{count}", String(count)));
  }

  updateBadge();
  window.addEventListener(CART_EVENT, updateBadge);
  window.addEventListener("storage", (event) => {
    if (event.key === CART_KEY) updateBadge();
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-s);
    top: -3rem;
    z-index: 20;
    padding: var(--space-xs) var(--space-s);
    background: var(--color-ivory);
  }
  .skip-link:focus {
    top: var(--space-s);
  }
  /* Opaque on purpose: a translucent, blurred header shows ghost shapes of
     the content scrolling under it on iOS Safari. */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: var(--rule);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-s) var(--gutter);
  }
  .home {
    color: var(--color-raspberry);
  }
  .logo {
    width: 5.5rem;
    height: auto;
    transition: transform 0.25s ease;
  }
  .home:hover .logo,
  .home:focus-visible .logo {
    transform: scale(1.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .logo {
      transition: none;
    }
  }
  nav {
    margin-inline-start: auto;
  }
  ul {
    display: flex;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }
  nav a,
  .lang,
  .menu-toggle {
    color: var(--color-text);
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  nav a:hover,
  .lang:hover,
  .menu-toggle:hover,
  nav a:focus-visible,
  .lang:focus-visible,
  .menu-toggle:focus-visible {
    color: var(--color-accent);
  }
  .lang:hover,
  .menu-toggle:hover {
    transform: translateY(-0.1rem);
  }
  nav a:hover,
  nav a:focus-visible {
    transform: translateX(0.2rem);
  }
  @media (prefers-reduced-motion: reduce) {
    nav a,
    .lang,
    .menu-toggle {
      transition: none;
    }
    .lang:hover,
    .menu-toggle:hover,
    nav a:hover,
    nav a:focus-visible {
      transform: none;
    }
  }
  .cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    margin-inline-start: var(--space-s);
    color: var(--color-text);
  }
  .header[data-menu] .cart {
    margin-inline-start: var(--space-xs);
  }
  .cart:hover,
  .cart:focus-visible {
    color: var(--color-accent);
  }
  .cart-text {
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
  }
  .badge {
    align-items: center;
    justify-content: center;
    min-width: 1.1rem;
    padding: 0 0.25rem;
    border-radius: var(--radius);
    background: var(--color-raspberry);
    color: var(--color-ivory);
    font-size: 0.7rem;
    line-height: 1.6;
  }
  .badge:not([hidden]) {
    display: inline-flex;
  }
  .lang {
    margin-inline-start: var(--space-s);
    padding-inline-start: var(--space-m);
    border-left: var(--rule);
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    padding: 0 var(--space-xs);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .menu {
    position: relative;
    order: 1;
    width: 100%;
    margin-inline-start: 0;
  }
  /* No JS: links stay visible as a wrapped row under the logo. */
  ul {
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
  }
  /* With JS: menu button opens a dropdown panel anchored to itself, desktop and mobile alike. */
  .header[data-menu] .menu {
    order: 0;
    width: auto;
    margin-inline-start: auto;
  }
  .header[data-menu] .menu-toggle {
    display: inline-flex;
  }
  .header[data-menu] .lang {
    margin-inline-start: var(--space-xs);
  }
  .header[data-menu] nav {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 12rem;
    width: max-content;
    background: var(--color-bg);
    border: var(--rule);
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem -0.5rem rgb(0 0 0 / 15%);
    opacity: 0;
    transform: translateY(-0.5rem);
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  .header[data-menu="open"] nav {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .header[data-menu="closed"] nav {
    display: none;
  }
  .header[data-menu] ul {
    flex-direction: column;
    gap: 0;
    padding: var(--space-xs) var(--gutter) var(--space-s);
  }
  .header[data-menu] nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }
  @media (max-width: 56rem) {
    .inner {
      flex-wrap: wrap;
      gap: var(--space-s);
    }
    .lang {
      margin-inline-start: auto;
      padding-inline-start: var(--space-s);
    }
    .header[data-menu] nav {
      min-width: 10rem;
    }
  }
</style>
