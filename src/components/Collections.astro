---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CollectionItem {
  id: string;
  name: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
}

interface Props {
  title: string;
  intro: string;
  thread: string;
  items: CollectionItem[];
}
const { title, intro, thread, items } = Astro.props;
---

<section id="collections" class="section" aria-labelledby="collections-title">
  <div>
    <h2 id="collections-title" class="section-title">
      {title}
    </h2>
    <p class="intro">{intro}</p>
    <ul>
      {items.map((item, i) => (
        <li>
          <a class="link" href={item.href}>
            <div class="frame">
              <Image
                src={item.image}
                alt={item.imageAlt}
                widths={[320, 640]}
                sizes="(max-width: 40rem) 50vw, 25vw"
              />
            </div>
            <span class="number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3>{item.name}</h3>
          </a>
          <p>{item.description}</p>
        </li>
      ))}
    </ul>
    <p class="thread">{thread}</p>
  </div>
</section>

<style>
  .intro,
  .thread {
    max-width: var(--measure);
    margin-inline: auto;
    text-align: center;
  }
  .thread {
    margin-top: var(--space-l);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding: 0;
    list-style: none;
  }
  li {
    text-align: center;
  }
  .link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.25rem;
    border-radius: 0.5rem;
  }
  .frame {
    overflow: hidden;
    border-radius: 0.5rem;
    transition: box-shadow 0.25s ease;
  }
  li:hover .frame,
  li:focus-within .frame {
    box-shadow: 0 0.75rem 1.5rem -0.5rem rgb(0 0 0 / 25%);
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    transform: scale(1.1);
    transition: transform 0.25s ease;
  }
  li:hover img,
  li:focus-within img {
    transform: scale(1.16);
  }
  @media (prefers-reduced-motion: reduce) {
    .frame,
    img {
      transition: none;
    }
    li:hover img,
    li:focus-within img {
      transform: none;
    }
  }
  .number {
    display: block;
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    transition: color 0.25s ease;
  }
  h3 {
    font-size: var(--text-xl);
    transition: color 0.25s ease;
  }
  li:hover .number,
  li:focus-within .number,
  li:hover h3,
  li:focus-within h3 {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .number,
    h3 {
      transition: none;
    }
  }
  p {
    font-size: var(--text-sm);
  }
</style>
