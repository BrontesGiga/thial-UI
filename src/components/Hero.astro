---
import { Image } from "astro:assets";
import Logo from "../assets/logo/thial-logo.svg";
import heroImage from "../assets/images/hero-candle.webp";
import type { Dictionary } from "../i18n/utils";

interface Props {
  hero: Dictionary["hero"];
}
const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="text">
    <h1 id="hero-title">
      <Logo class="logo" aria-hidden="true" />
      <span class="visually-hidden">Thial</span>
    </h1>
    <p class="tagline">{hero.tagline}</p>
    <p class="concept">{hero.concept}</p>
    <p class="intro">{hero.intro}</p>
    <a class="cta" href="#collections">
      {hero.cta}
    </a>
  </div>
  <Image
    class="photo"
    src={heroImage}
    alt={hero.imageAlt}
    widths={[480, 800, 1200]}
    sizes="(max-width: 48rem) 100vw, 40vw"
    loading="eager"
    fetchpriority="high"
  />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
    align-items: center;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-xl) var(--gutter);
  }
  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .logo {
    width: min(22rem, 80%);
    color: var(--color-raspberry);
  }
  .tagline {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  .concept {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
  }
  .intro {
    max-width: var(--measure);
    margin-top: var(--space-m);
  }
  .cta {
    display: inline-block;
    margin-top: var(--space-l);
    padding: var(--space-xs) var(--space-m);
    border: 1px solid var(--color-raspberry);
    border-radius: var(--radius);
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .cta:hover {
    background: var(--color-raspberry);
    color: var(--color-ivory);
  }
  .photo {
    width: 100%;
    max-height: 36rem;
    object-fit: cover;
    border-radius: 12rem 12rem 0 0;
  }
</style>
