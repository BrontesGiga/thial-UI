---
import CandleGrid from "./CandleGrid.astro";
import type { CandleItem } from "./CandleCard.astro";
import type { Dictionary } from "../i18n/utils";

interface Props {
  candles: Dictionary["candles"];
  items: CandleItem[];
  hasPlaceholders: boolean;
}
const { candles, items, hasPlaceholders } = Astro.props;
---

<section id="candles" class="section candles" aria-labelledby="candles-title">
  <div>
    <h2 id="candles-title" class="section-title">
      {candles.title}
    </h2>
    <p class="question">{candles.question}</p>
    <p class="intro">{candles.intro}</p>
    <CandleGrid
      items={items}
      aromaLabel={candles.aromaLabel}
      addLabel={candles.add}
      addedLabel={candles.added}
    />
    {hasPlaceholders && <p class="note">{candles.placeholderNote}</p>}
  </div>
</section>

<style>
  .candles {
    background: var(--color-surface);
  }
  .question {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    text-align: center;
  }
  .intro,
  .note {
    max-width: var(--measure);
    margin: var(--space-s) auto 0;
    text-align: center;
  }
  .note {
    margin-top: var(--space-l);
    font-size: var(--text-sm);
    font-style: italic;
  }
</style>
